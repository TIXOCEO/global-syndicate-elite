generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  BANNED
}

enum CharacterStatus {
  ACTIVE
  CRITICAL
  DEAD
}

enum CrimeType {
  STREET_THEFT
  BLACK_MARKET_DEAL
  WAREHOUSE_RAID
}

enum FactoryType {
  MINI
  SMALL
  MEDIUM
  LARGE
}

enum ItemType {
  MEDKIT_I
}

enum HitlistStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

model Country {
  id             String     @id
  name           String
  code           String     @unique
  borderSecurity Float      @default(1)
  createdAt      DateTime   @default(now())
  characters     Character[]
  territories    TerritoryCell[]

  @@index([code])
}

model Account {
  id              String        @id @default(uuid())
  email           String        @unique
  passwordHash    String
  referralCode    String        @unique
  referredByCode  String?
  eliteCredits    Int           @default(0)
  isEmailVerified Boolean       @default(false)
  googleId        String?       @unique
  status          AccountStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  characters      Character[]
  emailTokens     EmailVerificationToken[]
  passwordTokens  PasswordResetToken[]

  @@index([googleId])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([accountId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([accountId])
}

model Character {
  id                  String          @id @default(uuid())
  accountId           String
  account             Account         @relation(fields: [accountId], references: [id])
  nickname            String          @unique
  tier                Int             @default(1)
  rxp                 Int             @default(0)
  hp                  Int             @default(1000)
  notoriety           Int             @default(0)
  cash                Int             @default(0)
  lead                Int             @default(0)
  bullets             Int             @default(0)
  injurySeverity      Float           @default(0)
  status              CharacterStatus @default(ACTIVE)
  currentCountryId    String          @default("NL")
  country             Country         @relation(fields: [currentCountryId], references: [id])
  travelCooldownUntil DateTime?
  createdAt           DateTime        @default(now())
  diedAt              DateTime?
  lastCrimeAt         DateTime?
  protectionUntil     DateTime?
  recoveryUntil       DateTime?
  medkitCooldownUntil DateTime?

  skills              Skills?
  energy              Energy?
  jail                JailState?
  cooldown            CrimeCooldown?

  crimeLogs           CrimeLog[]
  factories           BulletFactory[]
  items               CharacterItem[]
  aircraft            CharacterAircraft?

  territoriesOwned    TerritoryCell[]

  combatLogsAttacker  CombatLog[]     @relation("CombatAttacker")
  combatLogsDefender  CombatLog[]     @relation("CombatDefender")

  knownLocationsViewed KnownLocation[] @relation("IntelViewer")
  knownLocationsTarget KnownLocation[] @relation("IntelTarget")

  hitlistsCreated HitlistContract[] @relation("HitlistCreator")
  hitlistsTarget  HitlistContract[] @relation("HitlistTarget")

  @@index([accountId])
  @@index([currentCountryId])
}

model CharacterAircraft {
  characterId  String   @id
  character    Character @relation(fields: [characterId], references: [id])
  aircraftTier Int
  createdAt    DateTime @default(now())
}

model TerritoryCell {
  id                String    @id @default(uuid())
  countryId         String
  country           Country   @relation(fields: [countryId], references: [id])
  gridX             Int
  gridY             Int
  ownerCharacterId  String?
  ownerCharacter    Character? @relation(fields: [ownerCharacterId], references: [id])
  controlPoints     Int       @default(0)
  createdAt         DateTime  @default(now())

  @@unique([countryId, gridX, gridY])
  @@index([countryId])
}

model TerritoryCombatLog {
  id              String   @id @default(uuid())
  attackerId      String
  defenderId      String
  territoryCellId String
  createdAt       DateTime @default(now())

  @@index([attackerId])
  @@index([defenderId])
  @@index([territoryCellId])
}

model KnownLocation {
  id                 String    @id @default(uuid())
  viewerCharacterId  String
  viewer             Character @relation("IntelViewer", fields: [viewerCharacterId], references: [id])
  targetCharacterId  String
  target             Character @relation("IntelTarget", fields: [targetCharacterId], references: [id])
  countryId          String
  discoveredAt       DateTime  @default(now())
  expiresAt          DateTime
  isFalseIntel       Boolean   @default(false)

  @@index([viewerCharacterId])
  @@index([targetCharacterId])
}

model DetectiveCooldown {
  id                 String   @id @default(uuid())
  viewerCharacterId  String
  targetCharacterId  String
  cooldownUntil      DateTime

  @@unique([viewerCharacterId, targetCharacterId], name: "viewer_target_unique")
  @@index([viewerCharacterId])
  @@index([targetCharacterId])
}

model BulletFactory {
  id                    String      @id @default(uuid())
  characterId           String
  character             Character   @relation(fields: [characterId], references: [id])
  factoryType           FactoryType
  productionRatePerHour Int
  productionProgress    Float       @default(0)
  lastProductionAt      DateTime    @default(now())
  createdAt             DateTime    @default(now())

  @@index([characterId])
}

model Skills {
  characterId   String    @id
  character     Character @relation(fields: [characterId], references: [id])
  shooting      Int       @default(0)
  smuggling     Int       @default(0)
  investigation Int       @default(0)
  jailXp        Float     @default(0)
  bustSkillXP   Float     @default(0)
}

model Energy {
  characterId String    @id
  character   Character @relation(fields: [characterId], references: [id])
  energy      Int       @default(100)
  lastRegenAt DateTime  @default(now())
}

model JailState {
  characterId          String    @id
  character            Character @relation(fields: [characterId], references: [id])
  jailRemainingSeconds Int       @default(0)
  lastUpdatedAt        DateTime  @default(now())
}

model JailActionLog {
  id        String   @id @default(uuid())
  actorId   String?
  targetId  String?
  action    String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetId])
}

model CrimeLog {
  id                 String    @id @default(uuid())
  characterId        String
  character          Character @relation(fields: [characterId], references: [id])
  crimeType          CrimeType
  success            Boolean
  cashGranted        Int
  leadGranted        Int
  shootingXpGranted  Int
  smugglingXpGranted Int
  rxpGranted         Int
  energyConsumed     Int
  createdAt          DateTime  @default(now())

  @@index([characterId, createdAt(sort: Desc)])
}

model CombatLog {
  id               String    @id @default(uuid())
  attackerId       String
  attacker         Character @relation("CombatAttacker", fields: [attackerId], references: [id])
  defenderId       String
  defender         Character @relation("CombatDefender", fields: [defenderId], references: [id])
  bulletsUsed      Int
  hit              Boolean
  damage           Float
  shootXp          Int
  rxp              Int
  notorietyGain    Int
  hitlistContractId String?
  hitlistContract   HitlistContract? @relation(fields: [hitlistContractId], references: [id])
  createdAt        DateTime @default(now())

  @@index([attackerId])
  @@index([defenderId])
}

model HitlistContract {
  id                   String        @id @default(uuid())
  creatorCharacterId   String
  creator              Character     @relation("HitlistCreator", fields: [creatorCharacterId], references: [id])
  targetCharacterId    String
  target               Character     @relation("HitlistTarget", fields: [targetCharacterId], references: [id])
  rewardCash           Int
  minBulletsRequired   Int
  deadline             DateTime
  isAnonymous          Boolean       @default(false)
  status               HitlistStatus @default(ACTIVE)
  createdAt            DateTime      @default(now())
  completedAt          DateTime?
  combatLogs           CombatLog[]

  @@index([targetCharacterId])
  @@index([status])
  @@index([deadline])
}

model CrimeCooldown {
  characterId String    @id
  character   Character @relation(fields: [characterId], references: [id])
  crimeType   String
  lastUsedAt  DateTime

  @@index([characterId])
}

model CharacterItem {
  id          String    @id @default(uuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id])
  itemType    ItemType
  quantity    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([characterId, itemType])
  @@index([characterId])
}
